# Shared by both GitHub workflows.
# If you change NANOVLLM_REF, FLASH_ATTN_VERSION or PYTHON_VERSION, run
# "Build flash-attn wheels" again before "Build and push image": the wheel must be
# compiled against exactly the torch that nanovllm-voxcpm's uv.lock pins at that ref.

NANOVLLM_REPO=https://github.com/a710128/nanovllm-voxcpm.git
# Commit you benchmarked (nano-vllm-voxcpm 2.0.5.post5+gb839543f6). Prefer a full SHA.
NANOVLLM_REF=b839543f6
FLASH_ATTN_VERSION=2.8.3.post2
PYTHON_VERSION=3.12
# NVIDIA apt package suffix: cuda-toolkit-13-2 -> /usr/local/cuda-13.2
CUDA_TOOLKIT=13-2
UV_VERSION=0.13.4
